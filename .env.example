# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/rajas_clinic

# Signs the login tokens. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Optional overrides
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# UPLOAD_DIR=uploads
